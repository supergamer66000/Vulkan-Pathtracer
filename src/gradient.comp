#version 450

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;

layout(set = 0, binding = 0, rgba32f) uniform writeonly image2D target_image;

layout(push_constant) uniform push_block {
    uint frame;
} push;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(target_image);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    const float pulse = 0.5 + 0.5 * sin(float(push.frame) * 0.02);
    imageStore(target_image, pixel, vec4(uv, pulse, 1.0));
}
